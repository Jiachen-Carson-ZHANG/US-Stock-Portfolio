APP_URL=http://localhost:3000

# Unset (or anything but "password") = open access, no sign-in at all.
# Set to "password" to require the four local accounts. Use that before
# putting the app on a public URL — a private link is not access control.
AUTH_MODE=

# openssl rand -base64 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Postgres connection string. Managed providers usually append ?sslmode=require.
# Local development: npm run db:dev:up starts one on port 55432.
DATABASE_URL=postgres://fpd:devpass@127.0.0.1:55432/portfolio

# Only when the provider's TLS certificate does not chain to a public root:
# on | no-verify | off. Leave unset to follow sslmode in the URL above.
# DATABASE_SSL=


# Total cash paid into the broker account, less withdrawals. Set it and the
# whole-journey return is measured against what you actually contributed.
# Leave blank and it is inferred from the broker's realized P&L, which omits
# positions closed outright and so overstates losses.
TOTAL_DEPOSITS=

# mock | moomoo
DATA_PROVIDER=mock

# From `npm run moomoo:register` (one-time; no developer portal needed).
MOOMOO_CLIENT_ID=

# Market prefix moomoo expects for bare tickers, e.g. US.AAPL
MOOMOO_MARKET=US

PORTFOLIO_BASE_CURRENCY=USD

QUOTE_CACHE_SECONDS=15
POSITION_CACHE_SECONDS=60

# Seed passwords for the four local accounts. Used only by `npm run db:seed`.
SEED_OWNER_PASSWORD=
SEED_FATHER_PASSWORD=
SEED_MOTHER_PASSWORD=
SEED_MILE_PASSWORD=
SEED_ZIZHE_PASSWORD=

# Optional. Enables the AI view and writing help on the watchlist.
# Works with any OpenAI-compatible provider.
DEEPSEEK_API_KEY=
# Host only, no path. Defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=
# Defaults to deepseek-flash (DeepSeek-V4.1-Flash).
# Other options: deepseek-v4-pro, or a model from any OpenAI-compatible provider.
DEEPSEEK_MODEL=

# Optional independent snapshot scheduler. Generate a separate random secret.
# POST /api/cron/snapshot with Authorization: Bearer <secret> every 15 minutes.
# The handler only captures after the US regular session, and only with fresh data.
SNAPSHOT_CRON_SECRET=

# Optional. With it, the Arena's commentary searches recent news to explain
# what moved. Without it the commentary still runs and says the move is
# unexplained — a missing search key should cost a paragraph, not the feature.
TAVILY_API_KEY=
