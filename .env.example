APP_URL=http://localhost:3000

# Unset (or anything but "password") = open access, no sign-in at all.
# Set to "password" to require the four local accounts. Use that before
# putting the app on a public URL — a private link is not access control.
AUTH_MODE=

# openssl rand -base64 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

DATABASE_URL=file:./data/portfolio.db

# mock | moomoo
DATA_PROVIDER=mock

# From `npm run moomoo:register` (one-time; no developer portal needed).
MOOMOO_CLIENT_ID=

# Market prefix moomoo expects for bare tickers, e.g. US.AAPL
MOOMOO_MARKET=US

PORTFOLIO_BASE_CURRENCY=USD

QUOTE_CACHE_SECONDS=15
POSITION_CACHE_SECONDS=60

# Seed passwords for the four local accounts. Used only by `npm run db:seed`.
SEED_OWNER_PASSWORD=
SEED_FATHER_PASSWORD=
SEED_MOTHER_PASSWORD=
SEED_MILE_PASSWORD=
SEED_ZIZHE_PASSWORD=

# Optional. Enables the AI view and writing help on the watchlist.
# Works with any OpenAI-compatible provider.
DEEPSEEK_API_KEY=
# Host only, no path. DeepSeek: https://api.deepseek.com
# Zhipu GLM: https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_BASE_URL=
# e.g. deepseek-chat, glm-4-flash, glm-4.5-flash
DEEPSEEK_MODEL=
