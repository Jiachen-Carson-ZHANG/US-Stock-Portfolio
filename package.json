{
  "name": "family-portfolio-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset-passwords": "tsx scripts/seed.ts --reset-passwords",
    "moomoo:register": "tsx scripts/moomoo-register.ts",
    "ai:test": "tsx scripts/ai-test.ts",
    "db:dev:up": "docker run -d --name fpd-pg -e POSTGRES_PASSWORD=devpass -e POSTGRES_USER=fpd -e POSTGRES_DB=portfolio -p 55432:5432 postgres:16",
    "db:dev:down": "docker rm -f fpd-pg",
    "db:migrate-from-sqlite": "tsx scripts/sqlite-to-postgres.ts",
    "db:e2e:reset": "tsx scripts/reset-e2e-db.ts",
    "db:import-fills": "tsx scripts/import-fills.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.5.0",
    "lucide-react": "^0.475.0",
    "next": "16.3.5",
    "pg": "^8.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^11.10.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.0.5"
  }
}
